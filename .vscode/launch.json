{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "ruby_lsp",
      "name": "Debug Rails server",
      "request": "launch",
      "program": "bin/rails server"
    },
    {
      "type": "ruby_lsp",
      "name": "Debug Rails console",
      "request": "launch",
      "program": "bin/rails console"
    },
    {
      "type": "ruby_lsp",
      "name": "Debug RSpec - current file",
      "request": "launch",
      "program": "bin/rspec ${file}"
    },
    {
      "type": "ruby_lsp",
      "name": "Debug Minitest - current file",
      "request": "launch",
      "program": "bin/rails test ${file}"
    }
  ]
}
