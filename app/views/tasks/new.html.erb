<h1>new task</h1>

<%= form_with(model: @task) do |form| %>
  <div>
    <%= form.label(:title)%>
    <%= form.text_field(:title) %>
  </div>

  <div>
    <%= form.label(:description) %>
    <%= form.text_area(:description) %>
  </div>

  <div>
    <%= form.label(:due_date) %>
    <%= form.date_field(:due_date) %>
  </div>

  <%= form.submit("Create Task") %>
<% end %>
